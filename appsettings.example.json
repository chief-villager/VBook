{
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=bookkeeping;User Id=SA;Password=<your-password>;TrustServerCertificate=True;Encrypt=True;"
  },
  "Jwt": {
    "Issuer": "Bookkeeping.Api",
    "Audience": "Bookkeeping.Api",
    "Key": "<generate-a-long-random-signing-key>"
  },
  "R2": {
    "AccountId": "<cloudflare-r2-account-id>",
    "AccessKeyId": "<r2-access-key-id>",
    "SecretAccessKey": "<r2-secret-access-key>",
    "Bucket": "<r2-bucket-name>",
    "PublicBaseUrl": "<r2-public-base-url>"
  },
  "Transactions": {
    "Mono": {
      "BaseUrl": "https://api.withmono.com/",
      "SecretKey": "<mono-secret-key>",
      "WebhookSecret": "<mono-webhook-secret>"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
