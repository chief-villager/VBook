# Base URL of the Bookkeeping API. Copy this file to `.env` and adjust.
# No trailing slash.
VITE_API_URL=http://localhost:5000

# Mono Connect *public* key, used client-side to open the bank-link widget on the
# dashboard. This is the publishable key (test_pk_… / live_pk_…) — never the secret
# key, which stays on the API. Get it from the Mono dashboard.
VITE_MONO_PUBLIC_KEY=
